#!/usr/bin/env bash
# scripts/bin/validate-custom — repo-specific validation, auto-discovered by vrg-validate
# (vergil_tooling.bin.vrg_validate._find_custom_validator looks for exactly this path).
# Runs the host-side check-*.sh assertions (Lima template generation, provision
# manifests, OpenTofu, cloud-init and its rootless-userns ordering, the
# dependency-update hook, vrg-vm-init series, vagrant plugin helpers, test_base.sh's
# shell-rc assertions, this list's parity with tests/run-host-tests.sh), then `tofu fmt`/`validate` for
# every provider module, plus `tofu test` where a module has a tests/ dir (mocked
# providers, plan-only). `tofu` is required: a missing `tofu` fails the run. fail-defer:
# run everything, report all failures, exit nonzero if any failed.
# Also runs in PR CI as the `quality / custom` job (vergil-actions >= v2.1.58); its log
# is `quality-custom.log` in the `quality / evidence` artifact.
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "${HERE}/../.." && pwd)"
fail=0

run() { echo "→ $*"; "$@" || fail=1; }

# 1) Host-side checks — no tofu or Lima needed, always run. The list between the
# markers is kept in step with tests/run-host-tests.sh's (run by scripts/build.sh),
# and tests/check-host-check-lists.sh fails when they differ. That list also runs
# check-opentofu-validate, which step 2 below covers here. One name per line.
# --- BEGIN host-checks ---
host_checks=(
  check-template-generation
  check-provision-manifest
  check-rootless-userns
  check-opentofu-contract
  check-opentofu-name-validation
  check-cloud-init-generation
  check-azure-volume-id-parse
  check-update-deps-hook
  check-vm-init-series
  check-vagrant-plugins
  check-test-base
  check-host-check-lists
)
# --- END host-checks ---
for chk in "${host_checks[@]}"; do
  s="${ROOT}/tests/${chk}.sh"
  if [ -f "$s" ]; then
    run bash "$s"
  else
    echo "ERROR: check script not found: $s" >&2
    fail=1
  fi
done

# 2) tofu fmt + validate per module. tofu is a required tool: a missing tofu is a
# hard failure, never a skip, so an image without it cannot pass validation.
if command -v tofu >/dev/null 2>&1; then
  for mdir in "${ROOT}"/opentofu/modules/*/volume "${ROOT}"/opentofu/modules/*/vm; do
    [ -d "$mdir" ] || continue
    echo "→ tofu fmt/validate/test ${mdir#"${ROOT}/"}"
    ( cd "$mdir" \
      && tofu fmt -check -recursive \
      && tofu init -backend=false -input=false >/dev/null \
      && tofu validate \
      && { [ ! -d tests ] || tofu test -no-color; } ) || fail=1
  done
else
  echo "ERROR: required tool not found on PATH: tofu" >&2
  fail=1
fi

exit "$fail"
