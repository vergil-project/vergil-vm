#cloud-config
# GENERATED by scripts/build-cloud-init.sh from this skeleton + templates/provision/*.sh.
# Edit the skeleton or the provision scripts, never this committed cloud-init.yaml.

# Key-only SSH (spec security boundary) — never rely on the image default.
ssh_pwauth: false

write_files:
  - path: /etc/vergil/provision.env
    permissions: '0644'
    content: |
      @@PROVISION_ENV@@
  # Persistent-volume mount (spec "Persistent volume -> Mount"). Cloud-only: Lima uses
  # the /projects host mount instead. Format-on-first-use ONLY; abort loudly on a
  # foreign (unlabeled) filesystem rather than risk the laptop-analog data.
  - path: /opt/vergil/mount-volume.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -eux -o pipefail
      DEV=/dev/disk/by-id/google-vergil-data   # device_name set by the vm module
      MNT=/vergil
      LABEL=vergil-data
      mkdir -p "$MNT"
      fstype="$(blkid -o value -s TYPE "$DEV" 2>/dev/null || true)"
      label="$(blkid -o value -s LABEL "$DEV" 2>/dev/null || true)"
      if [ -z "$fstype" ]; then
        # Blank disk -> first use -> format with our label.
        mkfs.ext4 -L "$LABEL" "$DEV"
      elif [ "$label" != "$LABEL" ]; then
        echo "ERROR: $DEV has a foreign filesystem (type=$fstype label='$label'); refusing to mount/format (no-silent-failures)" >&2
        exit 1
      fi
      grep -q "[[:space:]]${MNT}[[:space:]]" /etc/fstab \
        || echo "LABEL=${LABEL} ${MNT} ext4 defaults,nofail 0 2" >> /etc/fstab
      mount "$MNT" || mount -a
  # Rootless containerd — the off-platform analog of Lima's `containerd: {user: true}`,
  # which installs the nerdctl-full bundle and starts the rootless user service. The
  # shared provision script 35-buildkit.sh ASSUMES that service already exists (it waits
  # on `systemctl --user is-active containerd`); on Lima it does, so on the cloud box we
  # set it up here — before the provision scripts run. Cloud-only: never reached on Lima.
  # (vergil-vm #232)
  - path: /opt/vergil/setup-containerd.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      set -eux -o pipefail
      . /etc/vergil/provision.env   # VERGIL_USER
      # Defensive no-op if the nerdctl-full bundle is somehow already present.
      if command -v containerd-rootless-setuptool.sh >/dev/null 2>&1; then exit 0; fi

      # Pinned explicitly; Lima tracks its own nerdctl version. Bump deliberately.
      NERDCTL_VERSION=2.3.3
      ARCH="$(dpkg --print-architecture)"   # amd64 | arm64 — matches the nerdctl asset arch

      export DEBIAN_FRONTEND=noninteractive
      apt-get update
      # Rootless prerequisites: newuidmap/newgidmap (uidmap), a per-user D-Bus
      # session (dbus-user-session), and a userspace overlay fs (fuse-overlayfs).
      apt-get install -y --no-install-recommends uidmap dbus-user-session fuse-overlayfs

      # nerdctl-full bundles containerd, nerdctl, buildkit, RootlessKit, slirp4netns,
      # and containerd-rootless-setuptool.sh under /usr/local. Verify before extract.
      tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
      base="https://github.com/containerd/nerdctl/releases/download/v${NERDCTL_VERSION}"
      tarball="nerdctl-full-${NERDCTL_VERSION}-linux-${ARCH}.tar.gz"
      curl -fsSL -o "${tmp}/${tarball}" "${base}/${tarball}"
      curl -fsSL -o "${tmp}/SHA256SUMS" "${base}/SHA256SUMS"
      ( cd "$tmp" && grep " ${tarball}\$" SHA256SUMS | sha256sum -c - )
      tar -C /usr/local -xzf "${tmp}/${tarball}"

      # A persistent (lingering) user systemd manager + /run/user/<uid> so the rootless
      # service survives the provisioning session and reboots — Lima's setup does this too.
      loginctl enable-linger "$VERGIL_USER"
      uid="$(id -u "$VERGIL_USER")"
      # XDG_RUNTIME_DIR must exist before the rootless setuptool will run.
      for _ in $(seq 1 30); do [ -d "/run/user/${uid}" ] && break; sleep 1; done

      # Install + start the rootless containerd user service AS the user, so the
      # downstream 35-buildkit.sh finds `systemctl --user is-active containerd` true.
      sudo -iu "$VERGIL_USER" env XDG_RUNTIME_DIR="/run/user/${uid}" \
        containerd-rootless-setuptool.sh install
# @@PROVISION_FILES@@
runcmd:
  - [ mkdir, -p, /etc/vergil ]
  # Mount the persistent volume BEFORE the provision scripts run (spec ordering).
  - [ bash, /opt/vergil/mount-volume.sh ]
  # Apply the logind fix (#74) BEFORE setup-containerd touches linger / the user systemd
  # manager — the established "logind first" ordering. It is cadence=boot and idempotent,
  # so the provision block harmlessly re-runs it in sequence below.
  - [ bash, /opt/vergil/provision/00-logind-fix.sh ]
  # Rootless containerd (cloud analog of Lima's containerd:user) BEFORE the provision
  # scripts, so 35-buildkit.sh finds the user service already running.
  - [ bash, /opt/vergil/setup-containerd.sh ]
# @@PROVISION_RUNCMD@@
  # Readiness is NOT gated here. The #1706 `create` orchestration polls
  # `cloud-init status --wait` over SSH and checks /etc/vergil/vm-spec.fingerprint
  # (written by 40-profile.sh), failing the create loudly if provisioning errored.
